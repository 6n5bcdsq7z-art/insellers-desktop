{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "INSELLERS VPN",
  "identifier": "su.insellers.vpn",
  "version": "1.0.0",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "INSELLERS VPN",
    "copyright": "INSELLERS",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "externalBin": [
      "binaries/xray",
      "binaries/wireproxy",
      "binaries/ins-helper",
      "binaries/sing-box"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libsecret-1-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RDRDMDUwRjk3MjNDMzkKUldRNVBITDVVTURVT0FWRmQyVFRpNi9BR05oWnBtODhzeVJxNThnR0RnZVkzZkdzWERxMmRhU0wK",
      "endpoints": [
        "https://vpn.insellers.su/app/desktop/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "insellers"
        ]
      }
    }
  }
}
