{
  "name": "insellers-market",
  "productName": "INSELLERS",
  "version": "1.0.0",
  "description": "Поставщики, товары и заявки INSELLERS",
  "author": "INSELLERS",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "su.insellers.market",
    "productName": "INSELLERS",
    "artifactName": "INSELLERS-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.cjs",
      "policy.cjs",
      "offline.html",
      "package.json",
      "updates.cjs",
      "mac-updates.cjs",
      "minisign.cjs"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "../assets"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "../assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "../assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "icon": "../assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/6n5bcdsq7z-art/insellers-desktop/releases/latest/download"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/6n5bcdsq7z-art/insellers-desktop.git",
    "directory": "market/apps/desktop"
  },
  "dependencies": {
    "blakejs": "1.2.1",
    "electron-updater": "6.8.9"
  }
}
