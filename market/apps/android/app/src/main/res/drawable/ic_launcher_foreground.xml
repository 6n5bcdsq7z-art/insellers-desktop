<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the existing brand artwork inside Android's central safe area.
     The OS supplies the circle/squircle mask; do not bake another frame into it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <bitmap android:src="@mipmap/ic_launcher_artwork" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
