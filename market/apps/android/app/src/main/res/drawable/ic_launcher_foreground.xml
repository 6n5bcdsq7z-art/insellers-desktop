<?xml version="1.0" encoding="utf-8"?>
<!-- 12/108 proportional inset keeps the original artwork in the safe area
     at every launcher size. Android supplies the outer circle/squircle mask. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="11.111111%" android:insetTop="11.111111%"
    android:insetRight="11.111111%" android:insetBottom="11.111111%">
    <bitmap android:src="@mipmap/ic_launcher_artwork" android:gravity="fill" android:filter="true" />
</inset>
